<Project>
  <PropertyGroup>
    <!-- Jen Windows (Pohoda, Jet OLEDB); -windows zároveň vypíná varování CA1416 u System.Data.OleDb. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Jet 4.0 OLEDB (MDB Pohody) existuje jen 32bit, proces musí být x86. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <SelfContained>false</SelfContained>
    <!-- OleDb potřebuje vestavěné COM; AOT ani trimming ho vypínají (ověřeno: „requires MDAC“). -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>

    <Company>NaPohodu</Company>
    <Product>NaPohodu</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
