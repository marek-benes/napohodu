<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>napohodu</AssemblyName>
    <RootNamespace>NaPohodu.App</RootNamespace>
    <!-- dotnet run: relativní cesty (např. --save-response) vůči složce, odkud se příkaz spouští, ne vůči projektu. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NaPohodu.Core\NaPohodu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NaPohodu.Tests" />
  </ItemGroup>

</Project>
