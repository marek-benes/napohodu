<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>napohodu</AssemblyName>
    <RootNamespace>NaPohodu.App</RootNamespace>
    <!-- dotnet run: relativní cesty (např. pro uložení odpovědi) vůči složce, odkud se příkaz spouští, ne vůči projektu. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NaPohodu.Core\NaPohodu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NaPohodu.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lokální (vývojová) konfigurace s heslem: pro dotnet run vedle exe ano, do publikace nikdy –
         produkční instalace má vlastní appsettings.Local.json, který se při aktualizaci nepřepisuje. -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
